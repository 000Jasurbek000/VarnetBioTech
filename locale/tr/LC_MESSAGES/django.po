msgstr "Kayıt ol"

#: bakalavr_qabuli.html
msgid ""
"my.uzbmb.uz da pasport, JSHSHIR va telefon orqali ariza. Fan bloki, ta’lim "
"tili va test hududi tanlanadi."
msgstr ""
"my.uzbmb.uz üzerinden pasaport, kimlik numarası ve telefon ile başvuru "
"yapılır. Ders bloğu, öğretim dili ve sınav bölgesi seçilir."

#: bakalavr_qabuli.html
msgid "Kirish testi (DTM)"
msgstr "Giriş sınavı (DTM)"

#: bakalavr_qabuli.html
msgid ""
"5 ta fan: 3 majburiy + 2 profil. 90 ta savol, maksimal 189 ball. Natija "
"shaxsiy kabinetda e’lon qilinadi."
msgstr ""
"5 ders: 3 zorunlu + 2 alan dersi. 90 soru, azami 189 puan. Sonuçlar kişisel "
"hesapta yayımlanır."

