#: bakalavr_qabuli.html
msgid ""
"O‘zbekiston Respublikasida 2024/2025 o‘quv yilidan joriy etilgan «avval test"
" — keyin tanlov» tizimi asosida amalga oshiriladi. Rasmiy platforma:"
msgstr ""
"Özbekistan Cumhuriyeti'nde 2024/2025 eğitim yılından itibaren uygulanan "
"«önce sınav — sonra tercih» sistemine göre gerçekleştirilir. Resmî platform:"

#: bakalavr_qabuli.html topshiriladigan_hujjatlar.html
msgid "my.uzbmb.uz"
msgstr "my.uzbmb.uz"

