# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# `.env` hech qachon git ga yuklanmaydi (.gitignore da).

# Ishlab chiqarish uchun majburiy. Yangi kalit yaratish:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Mahalliy ishlab chiqishda True, serverda albatta False
DJANGO_DEBUG=True

# Vergul bilan ajratilgan domenlar (DEBUG=False bo'lganda majburiy)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS orqali kiriladigan domenlar, masalan: https://varnet.uz,https://www.varnet.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTP so'rovlarni HTTPS ga yo'naltirish (server SSL bilan ishlaganda True)
DJANGO_SECURE_SSL_REDIRECT=True
